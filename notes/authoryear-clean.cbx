\ProvidesFile{authoryear-clean.cbx}

\RequireCitationStyle{authoryear-comp}

% "&" before the final name, with a preceeding comma if there are more than 2.
\DeclareDelimFormat[parencite]{finalnamedelim}{
    \ifnumgreater{\value{liststop}}{2}{\addcomma}{}
    \addspace\&\addspace
}

\ExecuteBibliographyOptions{
    maxcitenames=2,
    uniquename=init,
}
